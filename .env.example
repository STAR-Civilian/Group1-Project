# Required. Generate one with: openssl rand -base64 50
SECRET_KEY=
ONET_API_KEY=secret-key-goes-here
# Local development. On the server: DEBUG=False
DEBUG=True
# On the server, set this to the server's address (e.g. your EC2 IP or domain)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173
DB_NAME=group1_db
DB_USER=group1_user
DB_PASSWORD=password-goes-here
# Used only when running Django outside Docker. Inside Docker, docker-compose.yml sets these to db / 5432.
DB_HOST=localhost
DB_PORT=5433

USE_MOCK_LLM=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5